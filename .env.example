# Render proporciona PORT y RENDER_EXTERNAL_URL automáticamente.
PORT=5173
# Demo gratuita en Render: salas temporales en memoria, sin disco.
# STORAGE_MODE=ephemeral
# Local: .runtime. Opcional para alojamiento con disco persistente:
# DATA_DIR=/var/data
# Solo si se conecta un dominio propio; usar su origen HTTPS.
# PUBLIC_URL=https://juego.example.com
# Fuera de Render, habilitar solo detrás de un proxy de confianza.
# TRUST_PROXY=1
